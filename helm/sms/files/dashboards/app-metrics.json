{
  "uid": "sms-frontend-overview",
  "title": "SMS Frontend Overview",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "query": "30s,1m,5m,10m",
        "current": { "selected": true, "text": "1m", "value": "1m" },
        "label": "Interval"
      }
    ]
  },
  "panels": [
    {
      "type": "gauge",
      "title": "Frontend Processing Requests (Absolute)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "sum by (version) (frontend_processing_requests)",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Rate (Relative)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "sum by (version) (rate(sms_requests_total[$interval]))",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total Requests (Absolute)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum by (version) (sms_requests_total)",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Spam vs Ham Rate (Relative)",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum by (version, category) (rate(sms_prediction_result_total[$interval]))",
          "legendFormat": "{{version}} – {{category}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "SMS Input Length Distribution (Absolute)",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (le) (increase(sms_input_length_bucket[$interval]))",
          "format": "heatmap",
          "refId": "A"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "SMS Input Length Distribution (Relative)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (le) (rate(sms_input_length_bucket[$interval]))",
          "format": "heatmap",
          "refId": "A"
        }
      ]
    }
  ],
  "time": { "from": "now-30m", "to": "now" }
}
