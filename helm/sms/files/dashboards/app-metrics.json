{
  "uid": "sms-frontend-overview",
  "title": "SMS Frontend Overview",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "query": "30s,1m,5m,10m",
        "current": { "selected": true, "text": "1m", "value": "1m" },
        "label": "Interval"
      }
    ]
  },
  "panels": [
    {
      "type": "gauge",
      "title": "Cumulative Sessions Started",
      "description": "Total number of unique sessions initiated since pod start.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "targets": [
        {
          "expr": "frontend_active_sessions",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total Requests (Absolute)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "increase(sms_requests_total[$interval])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Spam vs Ham Rate per Frontend Pod",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "options": {
        "displayMode": "bars",
        "barWidth": 0.85
      },
      "targets": [
        {
          "expr": "sum(rate(sms_prediction_result_total[$interval])) by (category, pod)",
          "legendFormat": "{{pod}} – {{category}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "SMS Input Length Distribution",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum by (le)(increase(sms_input_length_bucket[$interval]))",
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "options": {
        "color": {
          "mode": "scheme",
          "scheme": "Greens"
        }
      }
    }
  ],
  "time": { "from": "now-30m", "to": "now" }
}