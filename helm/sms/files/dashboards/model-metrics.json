{
  "uid": "sms-model-overview",
  "title": "SMS Model Overview",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "query": "30s,1m,5m,10m",
        "current": { "selected": true, "text": "1m", "value": "1m" },
        "label": "Interval"
      }
    ]
  },
  "panels": [
    {
      "type": "gauge",
      "title": "Model File Size (bytes)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "model_file_size_bytes",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total Predictions per Version",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum by (version) (model_predictions_total)",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Prediction Latency",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (version, le) (rate(model_prediction_latency_seconds_bucket[$interval])))",
          "legendFormat": "p95 {{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Shadow Consistency Ratio",
      "description": "v3 predictions / (v1 + v2)",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 4 },
      "targets": [
        {
          "expr": "sum(model_predictions_total{version=\"v3\"}) / sum(model_predictions_total{version=~\"v1|v2\"})",
          "refId": "A"
        }
      ]
    }
  ],
  "time": { "from": "now-30m", "to": "now" }
}
