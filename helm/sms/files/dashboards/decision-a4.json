{
  "uid": "sms-a4-experiment",
  "title": "SMS A4 Experiment Dashboard",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "query": "30s,1m,5m,10m",
        "current": { "selected": true, "text": "1m", "value": "1m" },
        "label": "Interval"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate per Version (Relative)",
      "description": "Canary (v2) should show higher RPS than Stable (v1).",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "sum by (version) (rate(sms_requests_total[$interval]))",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total Requests per Version (Absolute)",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "sum by (version) (sms_requests_total)",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Latency per Version (Safety Metric)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (version, le) (rate(frontend_request_latency_seconds_bucket[$interval])))",
          "legendFormat": "p95 {{version}}",
          "refId": "A"
        }
      ]
    }
  ],
  "time": { "from": "now-15m", "to": "now" }
}
